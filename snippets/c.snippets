## Main
# main
snippet main
    int main(int argc, char *argv[]) {
        ${0:// TODO some code}
    }
# main(void)
snippet mainv
    int main(void) {
        ${0:// TODO some code}
    }

## Preprocessor
# if not defined
snippet ifndef
    #ifndef $1
    #define ${1:SYMBOL}
    ${2:// TODO header}
    #endif // $1

## Common forms
# malloc-er
snippet mkstruct
    $1 mk_$2() {
        $1 ${3:val} = malloc(sizeof($1));
        ${4:// TODO extra init}
        return ${3:val};
    }
# destruct-er
snippet delstruct
    void del_$1($2 ${3:val}) {
        if (${3:val} == NULL)
            return;
        ${4:// TODO extra deletions}
        free(${3:val});
    }

## Null checks
# null check
snippet null
    if ($0 == NULL)
        return $1;
# reverse null-check
snippet nonnull
    if ($0 != NULL)
        return $1;

## Useful operations
# ternaries
snippet ternary
    $1 : $2 ? $3;
# else if
snippet elif
    else if ($1) {
        ${2:// TODO}
    }

## Loops
# do~while
snippet dowhile
    do {
        ${1:// TODO}
    } while($2);
# while loop
snippet while
    while ($1) {
        ${2:// TODO}
    }
# for i loop
snippet fori
    for (int i = 0; i < $1; i++) {
        ${2:// TODO}
    }
