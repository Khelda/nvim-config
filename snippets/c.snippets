## Main
# main
snippet main
    int main(int argc, char *argv[]) {
        $0
    }
# main(void)
snippet mainv
    int main(void) {
        $0
    }

## Preprocessor
# if not defined
snippet ifndef
    #ifndef $1
    #define ${1:SYMBOL}
    $2
    #endif // $1

## Common forms
# malloc-er
snippet mkstruct
    $1 *val = malloc(sizeof($1));
    ${2:// TODO init}
    return val;
# deleter
snippet delstruct
    if (!val)
        return;
    ${2:// TODO deletions}
    free(val);

## Null checks
# null check
snippet nlchk
    if (!$0)
        return $1;

## Useful operations
# ternaries
snippet ternary
    $1 : $2 ? $3;
# else if
snippet elif
    else if ($1) {
        ${2:// TODO}
    }

## Loops
# do~while
snippet dowhile
    do {
        ${1:// TODO}
    } while($2);
# for i loop
snippet fori
    for (int i = 0; i < $1; i++) {
        ${2:// TODO}
    }
